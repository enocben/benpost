# Front — variables d'environnement (copier vers .env et remplir)
# Bun/Astro charge .env automatiquement (PUBLIC_ exposé côté client)

# ── API back ──
# URL du back (Elysia). 3002 en local (Dokploy occupe 3000), prod = URL publique
PUBLIC_API_URL=http://localhost:3002
# API_URL=http://localhost:3002              # alias serveur accepté (PUBLIC_API_URL prioritaire)

# ── Webhook synchro DB → markdown statique ──
# Secret partagé avec le back (même valeur que apps/back/.env -> WEBHOOK_SECRET)
# Requis en prod pour que POST /api/webhook/posts soit accepté
#WEBHOOK_SECRET=change-me-webhook-secret

# ── Synchro build (scripts/sync-content.ts) ──
# API_URL ou PUBLIC_API_URL déjà ci-dessus — utilisé par prebuild (bun run sync:content)

# ── Astro / Node (optionnel) ──
#PORT=4321
#HOST=0.0.0.0
#SITE=https://benpost.example.com
