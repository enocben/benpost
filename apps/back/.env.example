# Back — variables d'environnement (copier vers .env et remplir)
# Bun charge .env automatiquement (pas de dotenv)

# ── Obligatoire ──
APP_SECRET=change-me-en-prod-min-32-chars   # secret JWT (sign/verify)

# ── Ports ──
# 3002 en local (3000 occupé par Dokploy), 3000 en prod
PORT=3002
# BACK_PORT=3002                             # alias accepté (PORT prioritaire)

# ── Seed admin (bun --filter=back run db:seed) ──
ADMIN_EMAIL=admin@benpost.local
ADMIN_PASSWORD=ChangeMe123!

# ── Synchro front → markdown statique (optionnel en local, requis en prod) ──
# URL du front qui reçoit POST /api/webhook/posts
# En local, vide = écriture directe apps/front/src/content/blog/<slug>.md
# En prod: URL publique du front
#FRONT_WEBHOOK_URL=https://benpost.example.com/api/webhook/posts
# Secret partagé avec le front (même valeur dans apps/front/.env -> WEBHOOK_SECRET)
#WEBHOOK_SECRET=change-me-webhook-secret

# ── Upload S3 / R2 (optionnel) ──
#S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
#S3_ACCESS_KEY_ID=...
#S3_SECRET_ACCESS_KEY=...
#S3_BUCKET=benpost
